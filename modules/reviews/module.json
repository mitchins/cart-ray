{
  "name": "cartray-reviews",
  "version": "0.0.3",
  "installation": "explicit",
  "default_mode": "disabled",
  "supported_modes": [
    "disabled",
    "read_only",
    "collect",
    "verified_acquisition_only"
  ],
  "migrations": [
    "migrations/0001_native_subjects.sql",
    "migrations/0002_native_reviews.sql",
    "migrations/0003_native_lifecycle.sql",
    "migrations/0004_acquisition_invitations.sql",
    "migrations/0005_subject_display_names.sql",
    "migrations/0006_review_invitation_consent.sql",
    "migrations/0007_acquisition_rate_limits.sql",
    "migrations/0008_acquisition_rate_maintenance.sql",
    "migrations/0009_invitation_generations.sql",
    "migrations/0010_invitation_delivery_claim.sql",
    "migrations/0011_review_management.sql",
    "migrations/0012_review_recovery_requests.sql",
    "migrations/0013_recovery_retry_deferrals.sql",
    "migrations/0014_unified_feed_index.sql",
    "migrations/0015_imported_titles.sql",
    "migrations/0016_snapshot_provenance.sql",
    "migrations/0017_review_identity_links.sql",
    "migrations/0018_public_source_attribution.sql",
    "migrations/0019_subject_aliases.sql",
    "migrations/0020_automation_intake.sql",
    "migrations/0021_staff_history_indexes.sql"
  ],
  "routes": [
    "GET /reviews/v1/subject-lookup?alias={alias}",
    "GET /reviews/v1/subjects/{subject_id}/summary",
    "GET /reviews/v1/subjects/{subject_id}/contributions",
    "POST /reviews/v1/contributions (collect, test only)",
    "GET /reviews-admin/v1/pending (collect, test only)",
    "GET /reviews-admin/v1/published (collect, test only)",
    "GET /reviews-admin/v1/contributions/{review_id}/{revisions|audit} (collect, test only)",
    "POST /reviews-admin/v1/* (collect, test only)",
    "POST /reviews-internal/v1/settlements (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/consents (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/revoke (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/replacement (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/recovery-next (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/recovery-command (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/recovery-prepare (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/recovery-cancel (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/recovery-defer (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/delivery-claim (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/invitations/delivery-outcome (verified_acquisition_only, test only)",
    "POST /reviews/v1/invitation (verified_acquisition_only, test only)",
    "POST /reviews/v1/invitation-recovery (verified_acquisition_only, test only)",
    "POST /reviews/v1/manage/{review_id}/{read|edit|withdraw} (verified_acquisition_only, test only)",
    "POST /reviews/v1/contributions (verified_acquisition_only, test only)",
    "POST /reviews-internal/v1/automation-intake (verified_acquisition_only, test only, disabled by default)"
  ],
  "subscriptions": [],
  "scheduled_tasks": []
}
